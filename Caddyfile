(services) {
	redir /octoprint-mk3 /octoprint-mk3/
	handle_path /octoprint-mk3/* {
		reverse_proxy localhost:91 {
			header_up X-Script-Name /octoprint-mk3
			header_up X-Scheme {scheme}
		}
	}

	redir /octoprint-mk4 /octoprint-mk4/
	handle_path /octoprint-mk4/* {
		reverse_proxy localhost:92 {
			header_up X-Script-Name /octoprint-mk4
			header_up X-Scheme {scheme}
		}
	}

	redir /filaments /filaments/
	handle_path /filaments/* {
		reverse_proxy localhost:81
	}

	redir /sensor-visualizer /sensor-visualizer/visualizer.html
	redir /sensor-visualizer/ /sensor-visualizer/visualizer.html
	handle_path /sensor-visualizer/* {
		reverse_proxy localhost:8000
	}

	handle {
		root * /srv
		file_server
	}
}

# Plain HTTP for the LAN (by IP / short name). The Tailscale name is sent to
# HTTPS; Vaultwarden is never served over plain HTTP.
:80 {
	@ts host {$TS_DOMAIN}
	redir @ts https://{host}{uri} 307

	import services
}

# HTTPS via Tailscale. For *.ts.net names Caddy fetches the certificate from
# the local tailscaled (socket mounted in docker-compose.yml), no ACME setup.
# TS_DOMAIN comes from .env, e.g. host.tailnet-name.ts.net
{$TS_DOMAIN} {
	# Vaultwarden runs under this sub-path (DOMAIN in its .env includes it),
	# so the prefix is passed through, not stripped.
	redir /vaultwarden /vaultwarden/
	handle /vaultwarden/* {
		reverse_proxy localhost:8080
	}

	import services
}
